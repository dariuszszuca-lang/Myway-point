{
  "firestore": {
    "rules": "firestore.rules.tylko-odczyt"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "region": "europe-west1"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}